\ProvidesPackage{beamerthemesintef}[2021/11/02]

\RequirePackage{etoolbox}
\RequirePackage{tikz}

\newtoggle{noslidenumber}
\newtoggle{corners}\toggletrue{corners}
\newtoggle{picturecorners}\toggletrue{picturecorners}

\@ifclassloaded{beamer}{
  \DeclareOptionBeamer{noslidenumber}{\toggletrue{noslidenumber}}
  \DeclareOptionBeamer{nocorners}{\togglefalse{corners}}
  \DeclareOptionBeamer{nopicturecorners}{\togglefalse{picturecorners}}
  \ProcessOptionsBeamer
}{}

% Force 16:9 aspect ratio
\RequirePackage{geometry}
\geometry{paperwidth=16cm,paperheight=9cm}

% Caladea is a Cambria clone, Carlito a Calibri clone
\RequirePackage{caladea,carlito}
\renewcommand{\familydefault}{\sfdefault}

\RequirePackage{graphicx,sintefcolor}

% No navigation symbols
\setbeamertemplate{navigation symbols}{}

% ---------------------------------------------------------------------------
% Page decorations (Sapienza NLP layout)
% The decorations are vector PDFs drawn as the slide background:
%   decor_frame     -> triangle + logo in the lower-right corner (all slides)
%   decor_title     -> triangle + logo in the lower-left corner (title slide)
%   decor_watermark -> faded Sapienza emblem on the right (title slide)
% ---------------------------------------------------------------------------
% Size of the corner triangles, relative to the original layout.
% 1 = as large as in the Google Slides layout. Change with \cornerscale{0.85}
\newcommand{\@cornerscale}{0.7}
\newcommand{\cornerscale}[1]{\renewcommand{\@cornerscale}{#1}}
% Extra factor applied on top of \@cornerscale (ToC and backmatter slides use 1.5)
\newcommand{\@cornerfactor}{1}
% The decorations are full-page PDFs; scaling them about the page corner
% shrinks only the triangle, which stays anchored to that corner.
\newcommand{\@decorframe}{\iftoggle{corners}{\iftoggle{slidecorner}{%
  \vbox to\paperheight{\vss\hbox to\paperwidth{\hss
    \includegraphics[width=\@cornerfactor\dimexpr\@cornerscale\paperwidth\relax]{assets/decor_frame}}}}{}}{}}
\newcommand{\@decortitle}{\iftoggle{corners}{%
  \vbox to\paperheight{\vfill\hbox to\paperwidth{%
    \includegraphics[width=\@cornerscale\paperwidth]{assets/decor_title}\hfill}}}{}}
% Corners drawn over pictures (chapter and side-picture slides,
% full-screen title background); they follow both switches
\newcommand{\@picturedecorframe}{\iftoggle{picturecorners}{\@decorframe}{}}
\newcommand{\@picturedecortitle}{\iftoggle{picturecorners}{\@decortitle}{}}

% Switches, usable in the preamble or anywhere in the document
% (they apply from the next slide on). Theme options set the initial state:
%   \usetheme[nocorners]{sintef}         -> no corner triangles at all
%   \usetheme[nopicturecorners]{sintef}  -> no corner triangles over pictures
\newcommand{\cornerson}{\toggletrue{corners}}
\newcommand{\cornersoff}{\togglefalse{corners}}
\newcommand{\picturecornerson}{\toggletrue{picturecorners}}
\newcommand{\picturecornersoff}{\togglefalse{picturecorners}}
% Single slides: \begin{frame}[nocorner]{Title} (also \begin{sidepic}[nocorner]{img}{Title})
\newtoggle{slidecorner}
\AtBeginEnvironment{frame}{\global\toggletrue{slidecorner}}% reset on every slide
\define@key{beamerframe}{nocorner}[true]{\global\togglefalse{slidecorner}}
\newcommand{\@decorwatermark}{%
  \includegraphics[width=\paperwidth,height=\paperheight]{assets/decor_watermark}}
\setbeamertemplate{background}{\@decorframe}

% Optional footer text, shown next to the slide number.
% Empty by default: \footertext{My talk - Venue 2026}
\newcommand{\@footertext}{}
\newcommand{\footertext}[1]{\renewcommand{\@footertext}{#1}}
\newcommand{\footlinepayoff}[1]{\footertext{#1}} % old name, kept for compatibility

% Footer of normal slides: number and text at the bottom left
\setbeamertemplate{footline}{%
  \usebeamerfont{footline}\usebeamercolor[fg]{footline}%
  \hbox to\paperwidth{%
    \hskip15.6pt%
    \rlap{\iftoggle{noslidenumber}{}{\insertframenumber}}%
    \hskip17.5pt%
    \@footertext\hfil}%
  \vskip11pt%
}

% Footer of the title slide: text after the corner, number at the bottom right
\defbeamertemplate{footline}{title}{%
  \usebeamerfont{footline}\usebeamercolor[fg]{footline}%
  \hbox to\paperwidth{%
    \iftoggle{corners}{% right of the corner
      \hskip\dimexpr\@cornerscale\dimexpr136.5pt\relax+4pt\relax}{\hskip15.6pt}%
    \@footertext\hfil
    \iftoggle{noslidenumber}{}{\insertframenumber}%
    \hskip10.3pt}%
  \vskip11pt%
}

% Coordinate blocks with a colour (the footer is no longer coloured,
% the command is kept so that older documents still compile)
\newcommand{\footlinecolor}[1]{%
  \ifstrempty{#1}{%
    \setbeamercolor{block title}{fg=white,bg=maincolor}
    \setbeamercolor{block body}{fg=white,bg=maincolor}
  }{
    \setbeamercolor{block title}{fg=white,bg=#1}
    \setbeamercolor{block body}{fg=white,bg=#1}
  }%
}
\footlinecolor{}

\pgfdeclareimage[width=0.09\paperwidth]{logo}{assets/logo_RGB}
\pgfdeclareimage[width=0.09\paperwidth]{whitelogo}{assets/logo_RGB_negative}
\newcommand{\@logo}{logo}

% Set colours
% NOTE! Beamer colors should be set in the preamble. It often works fine in the 
%       document itself, but NOT for normal text foreground.
%       \themecolor should only be called from the preamble.
\newcommand{\themecolor}[1]{
	\ifstrequal{#1}{main}{%
        \setbeamercolor{footline}{fg=white}
		\setbeamercolor{frametitle}{fg=white}
		\setbeamercolor{framesubtitle}{fg=white!70!maincolor}
		\setbeamercolor{title bar}{fg=white!70!maincolor}
		\setbeamercolor{normal text}{fg=white,bg=maincolor}
		\setbeamercolor{structure}{fg=white}
		\renewcommand{\@logo}{whitelogo}
		\setbeamercolor{block title}{fg=maincolor,bg=sintefgrey}
		\setbeamercolor{block body}{fg=darkgray,bg=sintefgrey}
	}{%
        \setbeamercolor{footline}{fg=footergray}
		\setbeamercolor{frametitle}{fg=titlegray}
		\setbeamercolor{framesubtitle}{fg=subtitlegray}
		\setbeamercolor{title bar}{fg=subtitlegray}
		\setbeamercolor{normal text}{fg=titlegray,bg=white}
		\setbeamercolor{structure}{fg=maincolor}
		\renewcommand{\@logo}{logo}
		\setbeamercolor{block title}{fg=white,bg=maincolor}
		\setbeamercolor{block body}{fg=darkgray,bg=sintefgrey}
	}
}
\themecolor{white} % Default: white theme

\setbeamercolor{title}{fg=titlegray}
\setbeamercolor{subtitle}{fg=subtitlegray}
\setbeamercolor{alerted text}{fg=sintefred}
\setbeamercolor{author}{fg=titlegray}
\setbeamercolor{date}{fg=subtitlegray}

\setbeamerfont{author}{size=\footnotesize}
\setbeamerfont{date}{size=\scriptsize}
\setbeamerfont{title}{series=\mdseries,size=\fontsize{22.7}{26}}
\setbeamerfont{subtitle}{series=\mdseries,size=\fontsize{11}{13.5}}
\setbeamerfont{frametitle}{series=\bfseries,size=\fontsize{15}{17}}
\setbeamerfont{framesubtitle}{series=\mdseries,size=\fontsize{10}{12}}
\setbeamerfont{footline}{size=\fontsize{6.5}{8}}
\setbeamerfont{block title}{series=\centering\bfseries}

% Code to get prettier boxes
\setbeamertemplate{blocks}[rounded]

% Bullets in several levels
\setbeamertemplate{itemize item}{\textbullet}
\setbeamertemplate{itemize subitem}{\textemdash}
\setbeamertemplate{itemize subsubitem}{\ensuremath{\circ}}

\newenvironment{colorblock}[3][white]{%
	\begingroup
	\setbeamercolor{block title}{fg=#1,bg=#2}
	\setbeamercolor{block body} {fg=#1,bg=#2}
	\begin{block}{#3}
	}{%
	\end{block}
	\endgroup
}

% The logo now lives in the lower-right corner, so the headline is empty
\setbeamertemplate{headline}{}

% Margins of the Sapienza NLP layout
\setbeamersize{text margin left=19.7pt,text margin right=19.7pt}

% Title with a vertical bar on its left.
% #1: horizontal gap between bar and text, #2: text width, #3: content
\newcommand{\@barredtitle}[3]{%
  \begin{tikzpicture}[baseline=(bt.north)]
    \node[anchor=north west,inner xsep=0pt,inner ysep=2.5pt,
          text width=#2] (bt) at (#1,0)
          {\raggedright\spaceskip=0pt\xspaceskip=0pt\hyphenpenalty=10000\exhyphenpenalty=10000 #3};
    \usebeamercolor{title bar}%
    \draw[draw=title bar.fg,line width=1.4pt]
      ([xshift=-#1+0.7pt]bt.north west) -- ([xshift=-#1+0.7pt]bt.south west);
  \end{tikzpicture}%
}

% Define frame title and subtitle layout
\setbeamertemplate{frametitle}{%
  \vskip-6.8pt% title 13pt below the page top
  \hskip-4.4pt% bar sits 15.3pt from the page edge
  \@barredtitle{15.9pt}{\paperwidth-60pt}{%
    {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par}%
    \ifx\insertframesubtitle\@empty\else
      \vskip3pt{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}%
    \fi}%
  \vskip2pt
}

\def\@courseLabel{}
\def\@IDnumber{}

\newcommand{\course}[1]{\def\@courseLabel{#1}}
\newcommand{\IDnumber}[1]{\def\@IDnumber{#1}}

% Define the title page: bar 54pt from the left edge, text 29pt after it
\setbeamertemplate{title page}{%
  \vspace*{-14mm}% sit slightly above the vertical centre
  \hskip34.2pt
  \@barredtitle{28.9pt}{0.58\paperwidth}{%
    {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
    \ifx\insertsubtitle\@empty\else
      \vskip3pt{\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
    \fi
    \ifdefempty{\@courseLabel}{}{%
      {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\@courseLabel\par}}%
    \ifx\beamer@shortauthor\@empty\else
      \vskip8pt{\usebeamerfont{author}\usebeamercolor[fg]{author}\textbf{\insertauthor}%
        \ifdefempty{\@IDnumber}{}{ (\@IDnumber)}\par}%
    \fi
    \ifx\insertdate\@empty\else
      {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}%
    \fi}%
}

% Define slide splitting dimensions (e.g. title and chapter slides)
\newcommand{\TikzSplitSlide}[1]{%
  \rule{0.56\paperwidth}{0pt}%
  \begin{tikzpicture}
    \clip (-0.1\paperwidth,-0.5\paperheight) -- 
          ( 0.5\paperwidth,-0.5\paperheight) -- 
          ( 0.5\paperwidth, 0.5\paperheight) -- 
          ( 0.1\paperwidth, 0.5\paperheight) -- cycle; 
    \node at (0.2\paperwidth,0) {%
      \includegraphics[height=\paperheight]{#1}%
    };
  \end{tikzpicture}
}

\newbool{splittitle}
\newcommand{\@TitleBackground}{}
\newcommand{\titlebackground}{\@ifstar{\SplitBackground}{\FullBackground}}
\newcommand{\FullBackground}[1]{\renewcommand{\@TitleBackground}{#1}}
\newcommand{\SplitBackground}[1]{%
	\booltrue{splittitle}%
	\renewcommand{\@TitleBackground}{#1}%
}

% Overwrite the maketitle command for the title page.
% Without \titlebackground the faded emblem is used as background;
% with it, the given picture replaces the emblem.
\renewcommand{\maketitle}{
\begingroup
  \setbeamertemplate{background}{%
    \ifdefempty{\@TitleBackground}{%
      \rlap{\@decorwatermark}%
    }{%
      \ifbool{splittitle}{% picture on the right: it does not reach the corner
        \rlap{\TikzSplitSlide{\@TitleBackground}}\@decortitle
      }{% Normal, full-screen background
        \rlap{\includegraphics[height=\paperheight]{\@TitleBackground}}\@picturedecortitle
      }%
    }%
    \ifdefempty{\@TitleBackground}{\@decortitle}{}
  }
  \setbeamertemplate{footline}[title]
  \begin{frame}%
  \titlepage%
  \end{frame}%
\endgroup
}

% (no \makeatletter/\makeatother here: @ is already a letter in a .sty,
%  and \makeatother would break every \@-macro defined after this point)
\newenvironment{withoutheadline}{
    \setbeamertemplate{headline}[default]
    \def\beamer@entrycode{\vspace*{-\headheight}}
}{}

% Define chapter environment
\newenvironment{chapter}[3][]{% Args: image (optional), color, frame title
  \begingroup
  \themecolor{main}
  \setbeamertemplate{footline}{}
  \ifstrempty{#2}{
    \setbeamercolor{frametitle}{fg=white}
    \setbeamercolor{normal text}{fg=white,bg=maincolor}
  }{
    \setbeamercolor{frametitle}{fg=white}
    \setbeamercolor{normal text}{fg=white,bg=#2}
  }
  % chapter slides never have the corner triangle
  \ifstrempty{#1}{\setbeamertemplate{background}{}}{%
    \setbeamertemplate{background}{\TikzSplitSlide{#1}}}
  \setbeamertemplate{frametitle}{%
    \vspace*{8ex}
    \begin{beamercolorbox}[wd=0.45\textwidth]{frametitle}
      \usebeamerfont{frametitle}\insertframetitle\\
      \usebeamerfont{framesubtitle}\insertframesubtitle
    \end{beamercolorbox}
  }
  \begin{frame}{#3}
  \hspace*{0.05\textwidth}%
  \minipage{0.35\textwidth}%
  \usebeamercolor[fg]{normal text}%
}{%
  \endminipage
  \end{frame}
  \endgroup
}

% Define sidepic environment
\newenvironment{sidepic}[3][c]{% Args: frame options (optional, default c), image, frame title
  \begingroup
  \setbeamertemplate{background}{%
  \rlap{\hspace*{0.6\paperwidth}\includegraphics[height=\paperheight]{#2}}%
  \@picturedecorframe
  }
  \setbeamertemplate{frametitle}{% Same as normal, but narrower
    \vskip-6.8pt
    \hskip-4.4pt
    \@barredtitle{15.9pt}{0.6\paperwidth-40pt}{%
      {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par}%
      \ifx\insertframesubtitle\@empty\else
        \vskip3pt{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}%
      \fi}%
    \vskip2pt
  }
  \begin{frame}[#1]{#3}
  \minipage{0.6\textwidth}%
}{%
  \endminipage
  \end{frame}
  \endgroup
}

% Define backmatter
\newcommand{\backmatter}[1][]{
\begingroup
  \themecolor{main}
  \renewcommand{\@cornerfactor}{1.5}% larger corner triangle on the closing slide
  \begin{frame}[c]
    \centering
    \begin{minipage}{\textwidth}
      \usebeamercolor[fg]{normal text}
      \centering
      \ifstrequal{#1}{notitle}{}{
        \Huge \inserttitle
        \vspace{5mm}
      }
      \Large \textsl{Thank you for listening! \\ Any questions?}
    \end{minipage}
  \end{frame}
\endgroup
}

% Define sectioning and table of contents
\AtBeginSection[]
{
    \begingroup
    \themecolor{main}
    \renewcommand{\@cornerfactor}{1.5}% larger corner triangle on ToC slides
    \begin{frame}{Table of Contents}
        \tableofcontents[currentsection]
    \end{frame}
    \endgroup
}

% style of section presented in the table of contents
\setbeamertemplate{section in toc}{$\blacktriangleright$~\inserttocsection}

% automate subtitle of each frame
\pretocmd\beamer@checkframetitle{\framesubtitle{\thesection \, \secname}}{}{}

% avoid numbering of frames that are breaked into multiply slides
\setbeamertemplate{frametitle continuation}{}